# 复制变量名到本地 shell、Vercel 或 Render 的环境变量面板；不要提交真实值。
# 本地未配置时，项目自动使用内存示例数据和启发式提取，可完成离线演示。

# Supabase：仅供服务端 Functions 使用，绝不能写入 script.js 或浏览器代码。
LOST_FOUND_SUPABASE_URL=
LOST_FOUND_SUPABASE_SERVICE_ROLE_KEY=

# 邮箱密码账号：仅供服务端调用 Supabase Auth，推荐配置 anon/publishable key。
# 二选一即可；未配置时服务端仅把已有数据库 key 作为 apikey 使用。
LOST_FOUND_SUPABASE_ANON_KEY=
LOST_FOUND_SUPABASE_PUBLISHABLE_KEY=

# SiliconFlow：图像识别与自然语言结构化的真实 API 调用凭证。
LOST_FOUND_SILICON_FLOW_API_KEY=
SILICON_FLOW_BASE_URL=https://api.siliconflow.cn/v1/chat/completions
SILICON_FLOW_MODEL=Qwen/Qwen3-VL-8B-Instruct
SILICON_FLOW_TEXT_MODEL=deepseek-ai/DeepSeek-V4-Flash
SILICON_FLOW_FALLBACK_MODEL=Qwen/Qwen3-8B

# 生产环境必须配置随机强密钥；本地未配置时会生成进程级临时密钥。
LOST_FOUND_JWT_SECRET=

# 文本结构化调用的总预算与单次模型预算（毫秒）。只对临时错误最多降级一次。
SILICON_FLOW_TEXT_TOTAL_BUDGET_MS=28000
SILICON_FLOW_TEXT_PRIMARY_TIMEOUT_MS=18000
SILICON_FLOW_TEXT_FALLBACK_TIMEOUT_MS=9000

# 本地服务端口（可选）
PORT=4173
# 相对时间解析默认时区（保持旧环境变量完全兼容）
LOST_FOUND_TIME_ZONE=Asia/Shanghai
